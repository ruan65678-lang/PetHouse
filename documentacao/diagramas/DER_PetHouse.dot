digraph PetHouse {
  graph [rankdir=LR, splines=ortho, nodesep=0.55, ranksep=0.85, bgcolor="white", pad=0.35,
         label="PET HOUSE\nDIAGRAMA ENTIDADE-RELACIONAMENTO (DER)\nModelo lógico do banco de dados", labelloc=t, fontsize=22, fontname="Arial", compound=true];
  node [shape=record, style="rounded,filled", fillcolor="#F4F8FD", color="#315A86", penwidth=1.5,
        fontname="Arial", fontsize=10, margin="0.14,0.10"];
  edge [color="#425466", fontname="Arial", fontsize=9, arrowsize=0.75, penwidth=1.25];

  CLIENTE [label="{CLIENTE|PK id_cliente\lnome\ltelefone\lemail\lendereco\ldata_cadastro\l}"];
  PET [label="{PET|PK id_pet\lnome\ltipo\lraca\lidade\lFK cliente_id\l}"];
  AGENDAMENTO [label="{AGENDAMENTO|PK id_agendamento\ldata\lhorario\ltipo_procedimento\lstatus\lFK pet_id\l}"];
  PEDIDO [label="{PEDIDO|PK id_pedido\ldata\lstatus\ltotal\lFK cliente_id\l}"];
  ITEM_PEDIDO [label="{ITEM_PEDIDO|PK id_item\lquantidade\lpreco_unitario\lFK pedido_id\lFK produto_id\l}"];
  PRODUTO [label="{PRODUTO|PK id_produto\lnome\ldescricao\lpreco\lFK categoria_id\l}"];
  CATEGORIA [label="{CATEGORIA|PK id_categoria\lnome\ldescricao\l}"];
  ESTOQUE [label="{ESTOQUE|PK id_estoque\lquantidade\lestoque_minimo\lFK produto_id (UNIQUE)\l}"];
  FORNECEDOR [label="{FORNECEDOR|PK id_fornecedor\lnome\lcnpj\ltelefone\lemail\lendereco\l}"];
  FORNECEDOR_PRODUTO [label="{FORNECEDOR_PRODUTO|PK id\lFK fornecedor_id\lFK produto_id\lpreco_compra\ldata_fornecimento\lUNIQUE (fornecedor_id, produto_id)\l}", style="rounded,filled,dashed", fillcolor="#FFF9E9", color="#A87920"];
  ORCAMENTO [label="{ORCAMENTO|PK id_orcamento\ldata\lstatus\ltotal\lFK cliente_id\lFK pedido_id (NULL, UNIQUE)\l}"];
  FEEDBACK [label="{FEEDBACK|PK id_feedback\lnota\lcomentario\lFK pedido_id\l}"];

  CLIENTE -> PET [label="1 : N"];
  PET -> AGENDAMENTO [label="1 : N"];
  CLIENTE -> PEDIDO [label="1 : N"];
  PEDIDO -> ITEM_PEDIDO [label="1 : N"];
  PRODUTO -> ITEM_PEDIDO [label="1 : N"];
  CATEGORIA -> PRODUTO [label="1 : N"];
  PRODUTO -> ESTOQUE [label="1 : 1"];
  FORNECEDOR -> FORNECEDOR_PRODUTO [label="1 : N"];
  PRODUTO -> FORNECEDOR_PRODUTO [label="1 : N"];
  CLIENTE -> ORCAMENTO [label="1 : N"];
  ORCAMENTO -> PEDIDO [label="0 : 1", style=dashed, constraint=false];
  PEDIDO -> FEEDBACK [label="1 : N"];

  {rank=same; CLIENTE; CATEGORIA; FORNECEDOR}
  {rank=same; PET; PRODUTO; ORCAMENTO}
  {rank=same; AGENDAMENTO; ESTOQUE; FORNECEDOR_PRODUTO; PEDIDO}
  {rank=same; ITEM_PEDIDO; FEEDBACK}
}
